---
/**
 * Pirula-gomb (4.): min. 52 px magas, 999 px lekerekítés. A gomb mindig link (<a>),
 * a beküldő gomb a W4-ben külön komponens. Változatok:
 *   primary – akcent háttér, fehér szöveg (5,55:1)
 *   secondary – körvonalas, az aktuális szövegszínnel
 *   quiet – szöveges link nyíllal (tartalomba ültetett)
 */
import Arrow from './Arrow.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', arrow = false, class: className } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]}>
  <span>
    <slot />
  </span>
  {arrow && <Arrow />}
</a>

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: var(--dur-fast) var(--ease-out);
    transition-property: background-color, color, border-color;
  }

  .btn--primary,
  .btn--secondary {
    min-height: var(--control-h);
    padding-inline: 1.6em;
    border-radius: var(--radius-pill);
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: #a52a15;
  }

  .btn--secondary {
    border: 1.5px solid currentColor;
    color: var(--fg);
  }

  .btn--secondary:hover {
    background: rgb(20 19 15 / 0.06);
  }

  .btn--quiet {
    min-height: 44px; /* érintési cél (8.) */
    padding-block: 0.5em;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .btn--quiet:hover {
    text-decoration-color: currentColor;
  }

  @media (hover: hover) {
    .btn:hover .arrow {
      transform: translateX(4px);
    }
  }

  /* Prémium anyag (3.): ±tónus, belső fényél, színes árnyék, hoverre egyszeri sheen (700 ms) */
  @supports (--polish: 1) {
    .btn--primary {
      position: relative;
      overflow: hidden;
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.18),
        0 8px 18px -8px color-mix(in srgb, var(--accent) 25%, transparent);
    }

    .btn--primary,
    .btn--primary:hover {
      background-image: linear-gradient(rgb(244 241 234 / 0.07), rgb(20 19 15 / 0.07));
    }

    .btn--primary::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, #0000 30%, #fff3, #0000 70%);
      transform: translateX(-101%);
      pointer-events: none;
    }

    @media (hover: hover) {
      .btn--primary:hover::after {
        transform: translateX(101%);
        transition: transform var(--dur-m) var(--ease-out-expo);
      }
    }
  }
</style>
