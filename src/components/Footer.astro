---
/**
 * Lábléc (6.10): 4 oszlop (cégadatok, horgonyok, jogi linkek, domainek) + óriás „zolberg.”
 * szóvédjegy. Csak meglévő adat és létező oldal jelenik meg (nincs helyőrző, nincs halott link).
 * A cégadatok ugyanonnan jönnek, mint az impresszum és a JSON-LD (10., NAP).
 */
import Wordmark from './Wordmark.astro';
import { site, telHref } from '../lib/site.ts';
import { navAnchors, anchorHref, CONTACT_ID } from '../lib/nav.ts';

interface Props {
  onHome: boolean;
}
const { onHome } = Astro.props;
const c = site.company;

const pages = import.meta.glob('/src/pages/{adatkezeles,impresszum}.astro');
const legal = [
  { path: '/adatkezeles', label: 'Adatkezelési tájékoztató' },
  { path: '/impresszum', label: 'Impresszum' },
].filter((l) => `/src/pages${l.path}.astro` in pages);

const hasCompany = c.legal_name || c.address || c.tax_id || c.email || c.phone;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__cols">
      {hasCompany && (
        <section aria-labelledby="f-ceg">
          <h2 id="f-ceg" class="site-footer__title mono">
            Cégadatok
          </h2>
          <ul role="list">
            {c.legal_name && <li>{c.legal_name}</li>}
            {c.address && <li>{c.address}</li>}
            {c.tax_id && <li>Adószám: {c.tax_id}</li>}
            {c.email && (
              <li>
                <a href={`mailto:${c.email}`}>{c.email}</a>
              </li>
            )}
            {c.phone && (
              <li>
                <a href={telHref(c.phone)}>{c.phone}</a>
              </li>
            )}
          </ul>
        </section>
      )}
      <nav aria-labelledby="f-oldal">
        <h2 id="f-oldal" class="site-footer__title mono">
          Oldal
        </h2>
        <ul role="list">
          {navAnchors.map((a) => (
            <li>
              <a href={anchorHref(a.id, onHome)}>{a.label}</a>
            </li>
          ))}
          <li>
            <a href={anchorHref(CONTACT_ID, onHome)}>Kapcsolat</a>
          </li>
        </ul>
      </nav>
      {legal.length > 0 && (
        <nav aria-labelledby="f-jogi">
          <h2 id="f-jogi" class="site-footer__title mono">
            Jogi információk
          </h2>
          <ul role="list">
            {legal.map((l) => (
              <li>
                <a href={l.path}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <section aria-labelledby="f-domain">
        <h2 id="f-domain" class="site-footer__title mono">
          Domainek
        </h2>
        <ul role="list">
          <li>
            {site.domains.brand} <span class="muted">– ez az oldal</span>
          </li>
          <li>
            {site.domains.sender} <span class="muted">– a leveleim küldő-domainje</span>
          </li>
        </ul>
      </section>
    </div>
    <p class="site-footer__giant" aria-hidden="true">
      <Wordmark />
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--section) var(--space-4);
    border-block-start: 1px solid var(--line);
    font-size: 1rem;
  }

  .site-footer__cols {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }

  .site-footer__title {
    margin-block-end: var(--space-2);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    font-weight: 400;
    letter-spacing: 0;
  }

  .site-footer ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--ink);
  }

  .site-footer a:hover {
    color: var(--accent);
  }

  .site-footer__giant {
    max-width: none;
    margin-block-start: var(--space-7);
    color: var(--ink);
    /* A szóvédjegy kitölti a konténert: a „zolberg.” mért szélessége ≈ 3,12 em. */
    font-size: calc(min(100vw - 2 * var(--margin), var(--container)) / 3.2);
    line-height: 0.8;
  }

  @media (min-width: 834px) {
    .site-footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .site-footer__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
