---
/**
 * Szavankénti kiírás (prémium finomítás 5.2, V7) build-időben szétbontva: az elem `aria-label`-je
 * az eredeti mondat, a szó-span-ek `aria-hidden`-ek, így a képernyőolvasó egyben olvassa.
 * Nyugalomban a span-ek inline-ok (a sortörés és a betűformázás azonos a v1-gyel); a mozgást a
 * src/scripts/motion.ts adja a `[data-reveal]` elemeken, csak ha nincs reduced-motion.
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  text: string;
  as?: HTMLTag;
  id?: string;
  class?: string;
}
const { text, as: Tag = 'h2', id, class: className } = Astro.props;
const words = text.trim().split(/\s+/);
---

<Tag id={id} class={className} aria-label={text} data-reveal>
  {words.map((w, i) => (
    <>
      <span aria-hidden="true">{w}</span>
      {i < words.length - 1 && ' '}
    </>
  ))}
</Tag>
