---
/**
 * Visszaigazoló oldal az űrlap után (6., 11.): leírja, mi történik és mikor. Nem indexelhető,
 * nincs a sitemapben.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../lib/site.ts';
import { NBSP } from '../lib/format.ts';

const days = site.contact.response_days;
const email = site.company.email;
---

<Base title="Köszönöm, megkaptam – Zolberg" path="/koszonjuk" noindex>
  <section class="section thanks" aria-labelledby="koszonjuk-cim">
    <div class="container thanks__inner">
      <p class="mono muted">Kérés elküldve</p>
      <h1 id="koszonjuk-cim">Köszönöm, megkaptam.</h1>
      <ol class="thanks__steps">
        <li>
          Lemérem az oldalát mobilon és asztali gépen, a mérés forrását és dátumát is rögzítem.
        </li>
        <li>
          {days
            ? `${days}${NBSP}munkanapon belül elküldöm a rövid összefoglalót PDF-ben vagy e-mailben, forrásokkal.`
            : 'Elküldöm a rövid összefoglalót PDF-ben vagy e-mailben, forrásokkal.'}
        </li>
        <li>Ha kérdése van, válaszoljon arra a levélre. Hírlevelet nem küldök.</li>
      </ol>
      {email && (
        <p class="thanks__mail">
          Sürgős kérdés esetén: <a href={`mailto:${email}`}>{email}</a>
        </p>
      )}
      <Button href="/" variant="secondary">
        Vissza a főoldalra
      </Button>
    </div>
  </section>
</Base>

<style is:global>
  .thanks__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .thanks__steps {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-inline-start: 1.2em;
  }
</style>
